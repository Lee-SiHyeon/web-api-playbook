  "sourceScope": "Reviewed Coupang implementation snapshot and new portable diagnostics; no runtime credentials",
  "sharedAuthenticationCommit": "0907cb699bfaf46d7bf9a143b186c605fb72fdab",
  "transformations": [
    "Move consumer/WOW/session dependencies into the affiliate service pack",
    "Resolve protected storage and attested Partners auth from this repository",
    "Move public Goldbox and shipping helpers from the Naver app into this pack",
    "Extract the public general-price selector without unrelated market-search dependencies",
    "Relocate Flash Sale inventory and preserve anonymous GET contracts and partial coverage",
    "Replace fixed historical read/cooldown scripts with one bounded same-context diagnostic",
    "Add native-process mocked Partners restart regression and an offline regression runner",
    "Use a bounded 180-second DPAPI helper deadline and redact provider failure details"
  ],
  "excluded": [
    "Credentials and raw captures",
    "403 evasion or visitor cycling",
    "Fixed historical Flash Sale batch cardinality",
    "Personal checkout paths and browser handoff workers"
  ],
