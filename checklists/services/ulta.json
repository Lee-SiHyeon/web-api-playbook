    {
      "id": "catalog.search",
      "title": "Search Ulta products through a stable anonymous direct API client",
      "priority": "required",
      "applicability": "applicable",
      "requirement": "live",
      "implementation": {
        "files": [
          {
            "path": "lib/commerce/ulta.mjs",
            "exports": [
              "createUltaPublicClient"
            ]
          }
        ],
        "tests": [
          "tests/commerce-ulta.test.mjs"
        ],
        "cli": [
          {
            "path": "scripts/commerce.mjs",
            "tokens": [
              "ulta"
            ]
          }
        ]
      },
      "evidence": [
        {
          "kind": "http-public-read-v1",
          "origin": "https://www.ulta.com",
          "path": "/dxl/graphql",
          "mime": "application/json",
          "files": [
            "verification/commerce-ulta-live-2026-10-05.json"
          ],
          "hashPaths": [
            "lib/commerce/ulta.mjs"
          ],
          "companionReads": [
            {
              "key": "bootstrapRequest",
              "origin": "https://www.ulta.com",
              "path": "/search",
              "mime": "text/html"
            }
          ]
        }
      ],
      "sourceEvidence": [],
      "note": "The client obtains the current query and ProductListingResults content ID from the public first-party page state, then calls the observed /dxl/graphql endpoint directly over HTTP."
