{
  "schema": "playbook-client-packs-v1",
  "clients": [
    {
      "id": "gemini",
      "title": "Gemini web HTTP client",
      "directory": "service-packs/gemini",
      "entrypoint": "src/cli.mjs",
      "executionMode": "pure_http_with_observed_session_inputs",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "owner",
        "history",
        "text",
        "models",
        "settings",
        "sharing",
        "attachments",
        "media"
      ],
      "note": "Historical evidence and source-bound inputs; authentication and each operation require current validation."
    },
    {
      "id": "grok",
      "title": "Grok web HTTP client",
      "directory": "service-packs/grok",
      "entrypoint": "src/cli.mjs",
      "executionMode": "operation_specific_http_or_websocket",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "owner",
        "conversations",
        "workspaces",
        "model-selection",
        "text",
        "attachments",
        "media"
      ],
      "note": "Some operations need declared Python transports or captured inputs; inspect the native feature audit."
    },
    {
      "id": "chatgpt",
      "title": "ChatGPT web contract client",
      "directory": "service-packs/chatgpt",
      "entrypoint": "src/cli.mjs",
      "executionMode": "pure_http_contract_gated",
      "testGlobs": [
        "tests/*.test.mjs"
      ],
      "scope": [
        "contracts",
        "session",
        "read",
        "stream",
        "send",
        "media",
        "reconciliation"
      ],
      "note": "Uncaptured contracts remain blocked; a packaged scaffold is not live success."
    },
    {
      "id": "google-flow",
      "aliases": [
        "flow"
      ],
      "title": "Flow direct HTTP and optional UI backend",
      "directory": "service-packs/google-flow",
      "entrypoint": "src/cli.mjs",
      "executionMode": "phase_specific_http_with_optional_profile_or_gflow",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "project-media",
        "generation",
        "download",
        "session",
        "profile-sync"
      ],
      "note": "Session/bootstrap and optional gflow backend have separate browser requirements; see the native README."
    },
    {
      "id": "google-flow-bridge",
      "aliases": [
        "flow-bridge"
      ],
      "title": "Flow extension bridge",
      "directory": "service-packs/google-flow-bridge",
      "entrypoint": "src/cli.mjs",
      "executionMode": "browser_automation",
      "testGlobs": [],
      "scope": [
        "project-media",
        "generation",
        "download",
        "reconciliation"
      ],
      "note": "Preserved distinct XHR bridge; recurring RPCs need a signed-in Flow page and extension. No donor tests."
    },
    {
      "id": "gemini-bridge",
      "title": "Gemini retained protocol and bootstrap client",
      "directory": "service-packs/gemini-bridge",
      "entrypoint": "src/verify.mjs",
      "executionMode": "phase_specific",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "protocol",
        "bootstrap",
        "verification"
      ],
      "note": "The verify command is a live operation; read its README before invocation."
    },
    {
      "id": "grok-public-modes",
      "title": "Grok public model-mode reader",
      "directory": "service-packs/grok-public-modes",
      "entrypoint": "src/verify.mjs",
      "executionMode": "pure_http",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "public-models"
      ],
      "note": "The verify command sends public HTTP requests; listing this pack does not."
    },
    {
      "id": "adpick",
      "title": "Adpick authenticated HTTP and serverless handlers",
      "directory": "service-packs/adpick",
      "entrypoint": null,
      "testGlobs": [
        "test/*.test.js"
      ],
      "executionMode": "pure_http",
      "scope": [
        "login",
        "search",
        "campaigns",
        "malls",
        "links",
        "sdk",
        "banners",
        "reports"
      ],
      "note": "Library and api/ handlers; native write guards are preserved. No generic writer is added."
    },
    {
      "id": "threads-actions",
      "aliases": [
        "threads-client"
      ],
      "title": "Threads profile, views and text-chain client",
      "directory": "service-packs/threads-actions",
      "entrypoint": "src/cli.mjs",
      "executionMode": "pure_http_with_caller_session",
      "testGlobs": [
        "test/*.test.mjs"
      ],
      "scope": [
        "profile",
        "views",
        "publish",
        "reply"
      ],
      "note": "Donor live_replay=false and protected-owner/readback limits remain explicit."
    },
    {
      "id": "naver-shopping",
      "title": "Naver shopping and travel HTTP readers",
      "directory": "service-packs/naver-shopping",
      "entrypoint": "scripts/naver-shopping.mjs",
      "executionMode": "pure_http",
      "testGlobs": [
        "tests/*.test.mjs"
      ],
      "scope": [
        "feed",
        "integrated-search",
        "product",
        "reviews",
        "travel"
      ],
      "note": "Product Document transport has an optional Python dependency; blocked JSON/review contracts remain blocked."
    },
    {
      "id": "naver-travel",
      "title": "Naver flight and hotel HTTP readers",
      "directory": "service-packs/naver-shopping",
      "entrypoint": "scripts/naver-travel.mjs",
      "executionMode": "pure_http",
      "testGlobs": [],
      "scope": [
        "flights",
        "calendar",
        "price-graph",
        "hotels",
        "hotel-rates",
        "travel-products"
      ],
      "note": "Tests are included in naver-shopping; no booking or payment writer."
    },
    {
      "id": "coupang-shopping",
      "title": "Coupang public feed HTTP reader",
      "directory": "service-packs/coupang-shopping",
      "entrypoint": "scripts/coupang-shopping.mjs",
      "executionMode": "pure_http",
      "testGlobs": [],
      "scope": [
        "feed",
        "deals",
        "sections",
        "find",
        "categories",
        "banner"
