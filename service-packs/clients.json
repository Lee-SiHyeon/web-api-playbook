    {
      "id": "whisk",
      "title": "Whisk image/project/reference SDK wrapper",
      "directory": "service-packs/whisk",
      "entrypoint": null,
      "executionMode": "pinned_sdk_not_live_verified",
      "testGlobs": [],
      "scope": [
        "projects",
        "references",
        "images",
        "media"
      ],
      "note": "Pinned @rohitaryal/whisk-api 4.0.0 wrapper; caller supplies the authorized session. No donor offline tests or live proof."
    },
    {
      "id": "creator-tools",
      "title": "Creator HTTP, TTS and declared browser helpers",
      "directory": "service-packs/creator-tools",
      "entrypoint": null,
      "executionMode": "helper_specific_http_or_browser_automation",
      "testGlobs": [],
