      "scope": [
        "read",
        "session",
        "management",
        "attachments"
      ],
      "note": "Shared Naver helpers resolve to the existing canonical pack; native journal/readback guards remain."
    },
    {
      "id": "social-actions",
      "title": "Naver/Tistory/X/Threads/Instagram social HTTP clients",
      "directory": "service-packs/operations",
      "entrypoint": "apps/social-actions/cli.mjs",
      "executionMode": "operation_specific_http_with_declared_session_provider",
      "scope": [
        "capabilities",
        "prepare",
        "execute",
        "reconcile",
        "instagram",
        "tiktok",
        "youtube",
        "naver-clip"
      ],
      "note": "Original service-specific journal, readback and explicit write boundaries remain. Bot schedulers are separate application logic.",
      "testManifest": "provenance/operations-consolidation-2026-10-23.json"
    },
    {
      "id": "affiliate-operations",
      "title": "Additional affiliate, vendor, place and creator HTTP adapters",
      "directory": "service-packs/operations",
      "entrypoint": "apps/affiliate-api-hub/scripts/xhr-tools.mjs",
      "executionMode": "operation_specific",
      "testGlobs": [],
      "scope": [
        "provider-contracts",
        "shopping",
        "vendor-reviews",
        "places",
        "creator-reads",
        "media"
      ],
      "note": "Library modules and native allowlisted scripts; tests run under social-actions for this shared dependency pack."
    },
    {
      "id": "automation",
      "title": "Coupang Partners, categories, reviews and Tistory observation workflows",
      "directory": "service-packs/automation",
      "entrypoint": "scripts/cli.mjs",
      "executionMode": "pure_http_with_caller_session",
      "testGlobs": [
        "tests/*.test.mjs"
      ],
      "scope": [
        "categories",
        "partners",
        "reports",
        "reviews",
        "measurements",
        "price-check",
        "intake",
        "public-health"
