    "upload:image": "node scripts/media-cli.mjs",
    "upload:video-attachment": "node scripts/media-cli.mjs --kind=video-attachment",
    "test": "node --test"
  },
  "dependencies": {
    "jsdom": "26.1.0",
    "tough-cookie": "5.1.2"
  }
}
