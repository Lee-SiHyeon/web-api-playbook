{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creator-promotion:schema:graph:v1",
  "title": "Creator promotion JSON-LD graph",
  "type": "object",
  "required": ["@id", "@context", "@type", "graphVersion", "generatedAt", "@graph"],
  "properties": {
    "@id": {"type": "string", "pattern": "^urn:creator-promotion:graph:"},
    "@context": {"type": "object", "required": ["ccp", "schema", "prov"]},
    "@type": {"const": "ccp:CreatorPromotionGraph"},
    "graphVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "@graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["@id", "@type"],
        "properties": {
          "@id": {"type": "string", "pattern": "^urn:creator-promotion:"},
          "@type": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
