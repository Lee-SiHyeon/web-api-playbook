{
  "manifest_version": 3,
  "name": "Local Google Flow XHR Bridge",
  "version": "0.1.0",
  "description": "Runs scoped Google Flow XHRs from the user's signed-in Flow page without exporting session credentials.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://flow.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:9417"
  }
}
